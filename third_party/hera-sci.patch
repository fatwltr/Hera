+void AuxProtocols::wrap_computation_prime(uint64_t *x, uint8_t *y,
+                                          int32_t size, int32_t bw_x,
+                                          uint64_t Q) {
+  assert(bw_x <= 64);
+  uint64_t *tmp_x = new uint64_t[size];
+  for (int i = 0; i < size; ++i) {
+    tmp_x[i] = party == sci::ALICE ? x[i] % Q : (Q - 1 - x[i]) % Q;
+  }
+  mill->compare(y, tmp_x, size, bw_x, true);
+  delete[] tmp_x;
+}
