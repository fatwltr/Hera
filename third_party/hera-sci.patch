+// Build the same prefix-dependent XOR pads as the nested per-leaf sum.
+// Every level shares its lower-bit prefix, reducing O(N log N) work to O(N).
+inline void ExpandOtPrefixPads(block* pads, const block* hashes, int logN) {
+  const int N = 1 << logN;
+  pads[0] = emp::zero_block;
+  for (int level = 0; level < logN; ++level) {
+    const int width = 1 << level;
+    const int offset = width - 1;
+    for (int prefix = 0; prefix < width; ++prefix) {
+      const block base = pads[prefix];
+      pads[prefix + width] = base ^ hashes[N - 1 + offset + prefix];
+      pads[prefix] = base ^ hashes[offset + prefix];
+    }
+  }
+}
