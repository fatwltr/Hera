+    void Evaluator::prepare_rotation(const Ciphertext &input, HoistedRotation &prepared,
+        MemoryPoolHandle pool) const
+    {
+        if (!is_metadata_valid_for(input, context_) || !is_buffer_valid(input) ||
+            input.size() != 2 || !input.is_ntt_form() || !pool)
+            throw invalid_argument("hoisting requires a valid size-2 NTT ciphertext and pool");
+        auto &data = *context_.get_context_data(input.parms_id());
+        if (data.parms().scheme() != scheme_type::ckks || !context_.using_keyswitching())
+            throw invalid_argument("rotation hoisting supports CKKS key switching only");
+        auto &key_parms = context_.key_context_data()->parms();
+        auto key_modulus = key_parms.coeff_modulus();
+        auto tables = context_.key_context_data()->small_ntt_tables();
+        const auto n = data.parms().poly_modulus_degree();
+        const auto q = data.parms().coeff_modulus().size();
+        if (!product_fits_in(q + 1, q, n)) throw invalid_argument("hoisting workspace overflow");
+        HoistedRotation next;
+        next.source_ = input;
+        next.digits_.resize((q + 1) * q * n);
+        SEAL_ALLOCATE_GET_RNS_ITER(coefficients, n, q, pool);
+        set_uint(input.data(1), q * n, coefficients);
+        inverse_ntt_negacyclic_harvey(coefficients, q, tables);
+        for (size_t i = 0; i <= q; ++i) {
+            const auto key_index = i == q ? key_modulus.size() - 1 : i;
+            for (size_t j = 0; j < q; ++j) {
+                CoeffIter digit(next.digits_.data() + (i * q + j) * n);
+                if (i == j) set_uint(input.data(1) + j * n, n, digit);
+                else {
+                    modulo_poly_coeffs(coefficients[j], n, key_modulus[key_index], digit);
+                    ntt_negacyclic_harvey(digit, tables[key_index]);
+                }
+            }
+        }
+        prepared = std::move(next);
+    }
+
+    void Evaluator::rotate_vector_hoisted(const HoistedRotation &prepared, int steps,
+        const GaloisKeys &keys, Ciphertext &output, MemoryPoolHandle pool) const
+    {
+        auto data = context_.get_context_data(prepared.source_.parms_id());
+        if (!data || prepared.source_.size() != 2 || data->parms().scheme() != scheme_type::ckks)
+            throw invalid_argument("invalid hoisted rotation source");
+        const auto q = data->parms().coeff_modulus().size(), n = data->parms().poly_modulus_degree();
+        if (!product_fits_in(q + 1, q, n) || prepared.digits_.size() != (q + 1) * q * n)
+            throw invalid_argument("invalid hoisted rotation workspace");
+        output = prepared.source_;
+        if (steps == 0) return;
+        auto elt = data->galois_tool()->get_elt_from_step(steps);
+        apply_galois_internal(output, elt, keys, std::move(pool), &prepared);
+    }
